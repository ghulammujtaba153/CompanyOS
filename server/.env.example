APP_NAME=CompanyOS API
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=0.0.0.0
PORT=8000

# Neon Postgres connection string (Dashboard → Connection details)
# Example: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

AUTO_CREATE_SCHEMA=true
SEED_ON_STARTUP=true

# Platform admin console (/admin) — created/updated on API startup
ADMIN_EMAIL=admin@companyos.io
ADMIN_PASSWORD=admin1234

JWT_SECRET=dev-change-me-companyos-jwt-secret
JWT_EXPIRE_MINUTES=10080

# Cloudinary — https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=companyos
# Optional workaround if API key lacks create permission:
# Settings → Upload → Upload presets → Add preset → Signing mode: Unsigned
CLOUDINARY_UPLOAD_PRESET=

# Public app URL (Stripe Checkout / Customer Portal return URLs)
SITE_URL=http://localhost:3000

# Stripe Billing — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Dashboard → Products price IDs. When empty, Checkout uses inline price_data.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# AI providers — set one or both
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_OPENAI_MODEL=gpt-4o-mini
AI_GEMINI_MODEL=gemini-2.5-flash
AI_EMBEDDING_PROVIDER=openai
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone vector store — https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX=companyos-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
# Retrieval: llamaindex (default) or pinecone (raw client)
RAG_RETRIEVAL_ENGINE=llamaindex
# Answer: langgraph (default)
RAG_ANSWER_ENGINE=langgraph

# Brevo transactional email (log classification issue alerts)
# Use SMTP key (xsmtpsib-…) + BREVO_SMTP_LOGIN, or API key (xkeysib-…)
# https://app.brevo.com/settings/keys/smtp
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CompanyOS Alerts
BREVO_ALERT_TO=ghulammujtaba.dro@gmail.com
